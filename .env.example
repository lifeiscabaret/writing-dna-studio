# Writing DNA Studio — environment template
#
# The app runs fully offline with NO configuration (local deterministic engine).
# Copy this file to `.env.local` ONLY if you want to enable the optional Azure
# AI Foundry rewrite with your OWN Azure resource:
#
#   cp .env.example .env.local
#
# `.env.local` is git-ignored. Never commit real keys.

# Enable the Azure AI Foundry rewrite provider (false => local fallback only).
AZURE_FOUNDRY_ENABLED=false

# Enable Azure/Foundry-backed knowledge grounding (false => local synthetic guidance).
AZURE_GROUNDING_ENABLED=false

# Your Azure AI Foundry resource (no trailing path needed).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Rewrite tuning (safe defaults).
AZURE_REWRITE_TIMEOUT_MS=15000
AZURE_REWRITE_REASONING_EFFORT=minimal
